  (require 'org-table)
  (let ((tables (with-temp-buffer
                  (insert-file-contents org-file)
                  (org-mode)
                  (tabularium-import--org-list-tables))))
    (cond
     ((null tables) (user-error "No tables found in %s"
                                (abbreviate-file-name org-file)))
     ((= 1 (length tables)) nil)
